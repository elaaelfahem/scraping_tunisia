# Copy this file to .env and fill in your values

# SerpAPI key — used for Google Maps scraping (reliable, no CAPTCHA)
# Get one at: https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Database (defaults to local SQLite if not set)
DATABASE_URL=sqlite:///./tunisian_companies.db

# PostgreSQL (used when running via docker-compose)
# DATABASE_URL=postgresql://admin:admin_password@localhost:5432/tunisian_companies
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
POSTGRES_DB=tunisian_companies
